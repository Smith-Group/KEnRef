prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: KEnRef Core
Description: Kinetic Ensemble Refinement Core Library (requires external Eigen3)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkenref_core @MPI_CXX_LIBRARIES_STR@
Cflags: -I${includedir}/core
# @MPI_CXX_COMPILE_OPTIONS_STR@ is harmful (containing ' >-pthread' instead of '> -pthread'
Requires: eigen3 >= 3.4.0