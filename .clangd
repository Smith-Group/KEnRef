# clangd configuration for KEnRef core.
# Point clangd at the CMake compile database so every TU (and the headers they include) resolves with
# the real include flags (Eigen, include_core, MPI, ...). Regenerated by CMAKE_EXPORT_COMPILE_COMMANDS.
# If you build into a different directory, change CompilationDatabase accordingly (or symlink
# compile_commands.json to the repo root).
CompileFlags:
  CompilationDatabase: cmake-build-debug
